# Copy to .env and fill in real values.
# Never commit .env to source control.

HABIT_SERVER_ENV=development
HABIT_SERVER_PORT=50051

HABIT_DATABASE_HOST=localhost
HABIT_DATABASE_PORT=5432
HABIT_DATABASE_NAME=habitdb
HABIT_DATABASE_USER=habit
HABIT_DATABASE_PASSWORD=habit_secret
HABIT_DATABASE_SSL_MODE=disable
HABIT_DATABASE_MAX_CONNS=20

# Minimum 32 characters. Generate with: openssl rand -hex 32
HABIT_JWT_SECRET=change-me-in-production-min-32-chars!!
